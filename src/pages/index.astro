---
import PageLayout from "../layouts/PageLayout.astro";

import Navigation from "../components/Navigation";
import HeroSection from "../components/HeroSection";
import ServicesSection from "../components/ServicesSection";
import ExamplesSection from "../components/ExamplsSection";
import ContactSection from "../components/ContactSection";
import Footer from "../components/Footer";
---

<PageLayout title="Best & Most Popular Graphics Shop | Shar Art Advertising">
  <div class="max-w-7xl h-screen mx-auto bg-transparent">
    <Navigation />
    <main
      class="w-full h-screen overflow-x-hidden overflow-y-auto snap-mandatory"
    >
      <!-- HERO SECTION -->
      <HeroSection />
      <!-- SERVICES SECTION -->
      <ServicesSection />
      <!-- EXAMPLE SECTION -->
      <ExamplesSection />
      <!-- CONTACT SECTION -->
      <ContactSection />
    </main>
    <Footer />
  </div>
</PageLayout>
